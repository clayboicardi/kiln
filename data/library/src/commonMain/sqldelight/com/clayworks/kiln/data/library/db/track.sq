-- Track table per schema sketch §3.3 — ~30 columns; the big one.
-- Soft-delete via deleted_at_ms preserves listening_history references when
-- files temporarily disappear (USB unplugged, cloud sync out of sync).

CREATE TABLE track (
    id                       INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    album_id                 INTEGER REFERENCES album(id),
    artist_id                INTEGER NOT NULL REFERENCES artist(id),

    title                    TEXT    NOT NULL,
    title_sort               TEXT    NOT NULL,
    duration_ms              INTEGER NOT NULL,
    track_number             INTEGER,
    disc_number              INTEGER,
    year                     INTEGER,
    date                     TEXT,
    genre                    TEXT,
    composer                 TEXT,
    bpm                      INTEGER,

    -- Audio format
    codec                    TEXT    NOT NULL,
    bitrate_kbps             INTEGER,
    sample_rate_hz           INTEGER NOT NULL,
    bit_depth                INTEGER,
    channels                 INTEGER NOT NULL,

    -- File location + change detection
    file_path                TEXT    NOT NULL UNIQUE,
    file_size_bytes          INTEGER NOT NULL,
    file_mtime_ms            INTEGER NOT NULL,

    -- ReplayGain (JAMZ-parity)
    replay_gain_track_db     REAL    DEFAULT NULL,
    replay_gain_album_db     REAL    DEFAULT NULL,
    replay_gain_track_peak   REAL    DEFAULT NULL,
    replay_gain_album_peak   REAL    DEFAULT NULL,

    -- Embedded art
    has_embedded_art         INTEGER NOT NULL DEFAULT 0,
    art_path                 TEXT    DEFAULT NULL,

    -- Provenance / audit
    source                   TEXT    NOT NULL DEFAULT 'local',
    date_added_ms            INTEGER NOT NULL,
    date_modified_ms         INTEGER NOT NULL,
    last_scanned_ms          INTEGER NOT NULL,
    deleted_at_ms            INTEGER DEFAULT NULL,

    -- Lazy stats
    play_count               INTEGER NOT NULL DEFAULT 0,
    skip_count               INTEGER NOT NULL DEFAULT 0,
    last_played_ms           INTEGER DEFAULT NULL,

    -- 1 = provider reported a real mtime; 0 = provider omitted (some SAF
    -- DocumentsProviders). Gates the unchanged-check on SAF passes.
    -- Added v2→v3 via migrations/2.sqm; SQLite's ALTER TABLE ADD COLUMN
    -- always appends to the END of the table, so this column MUST stay
    -- last in CREATE TABLE for verifyMigrations to pass.
    has_known_mtime          INTEGER NOT NULL DEFAULT 1,

    -- NULL = Android format facts not yet verified via MediaMetadataRetriever
    -- backfill (F10). Set to System.currentTimeMillis() once a later backfill
    -- pass has populated sample_rate_hz/bit_depth/channels/bitrate_kbps/has_embedded_art.
    -- Desktop scans set this at insert (JVM tag-read already authoritative).
    -- Added v3→v4 via migrations/3.sqm; MUST stay last (ALTER ADD COLUMN appends).
    metadata_backfilled_at_ms INTEGER DEFAULT NULL
);

-- All track-list indexes are PARTIAL — `WHERE deleted_at_ms IS NULL` is part
-- of the index definition, so soft-deleted rows don't bloat the index.

CREATE INDEX track_album_id           ON track(album_id) WHERE deleted_at_ms IS NULL;
CREATE INDEX track_artist_id          ON track(artist_id) WHERE deleted_at_ms IS NULL;
CREATE INDEX track_title_sort         ON track(title_sort) WHERE deleted_at_ms IS NULL;
CREATE INDEX track_date_added_desc    ON track(date_added_ms DESC) WHERE deleted_at_ms IS NULL;
CREATE INDEX track_last_played_desc   ON track(last_played_ms DESC) WHERE deleted_at_ms IS NULL AND last_played_ms IS NOT NULL;
CREATE INDEX track_play_count_desc    ON track(play_count DESC) WHERE deleted_at_ms IS NULL AND play_count > 0;
CREATE INDEX track_file_mtime_ms      ON track(file_mtime_ms) WHERE deleted_at_ms IS NULL;

selectAll:
SELECT * FROM track
WHERE deleted_at_ms IS NULL
ORDER BY title_sort
LIMIT :pageSize OFFSET :pageOffset;

selectById:
SELECT * FROM track
WHERE id = ? AND deleted_at_ms IS NULL;

-- Phase 2b-A (A1): per-track Spec Sheet read model. Full-row select so the
-- mapper can surface every format/RG/file fact. Live rows only.
selectSpecSheetEntry:
SELECT * FROM track WHERE id = ? AND deleted_at_ms IS NULL;

-- Phase 2b-A (A1): library aggregate totals for the Spec Sheet stats header.
-- SUM(...) columns are nullable (Long?) per SQLDelight — handle with ?: 0L.
aggregateTotals:
SELECT
    COUNT(*)                                                          AS total_tracks,
    COALESCE(SUM(file_size_bytes), 0)                                 AS total_bytes,
    SUM(CASE WHEN replay_gain_track_db IS NOT NULL THEN 1 ELSE 0 END) AS rg_covered,
    SUM(CASE WHEN has_known_mtime = 1        THEN 1 ELSE 0 END)        AS known_mtime
FROM track
WHERE deleted_at_ms IS NULL;

-- Phase 2b-A (A1): per-codec track counts for the aggregate codec breakdown.
aggregateCodecCounts:
SELECT codec, COUNT(*) AS cnt
FROM track
WHERE deleted_at_ms IS NULL
GROUP BY codec
ORDER BY cnt DESC;

selectByAlbum:
-- COALESCE handles NULL disc_number / track_number gracefully. In SQLite,
-- NULL sorts BEFORE non-NULL in ASC order, which would put untagged tracks
-- ABOVE disc 1. Treat null disc as disc 1 (overwhelming common case for
-- single-disc albums that don't tag), and null track_number as 999999 so
-- those untagged tracks sort to the END of the disc — better than the top.
SELECT * FROM track
WHERE album_id = ? AND deleted_at_ms IS NULL
ORDER BY COALESCE(disc_number, 1), COALESCE(track_number, 999999);

selectByArtist:
SELECT * FROM track
WHERE artist_id = ? AND deleted_at_ms IS NULL
ORDER BY title_sort
LIMIT :pageSize OFFSET :pageOffset;

selectByFilePath:
SELECT * FROM track
WHERE file_path = ?;

selectRecentlyAdded:
SELECT * FROM track
WHERE deleted_at_ms IS NULL
ORDER BY date_added_ms DESC
LIMIT :pageSize;

selectRecentlyPlayed:
SELECT * FROM track
WHERE deleted_at_ms IS NULL AND last_played_ms IS NOT NULL
ORDER BY last_played_ms DESC
LIMIT :pageSize;

selectMostPlayed:
SELECT * FROM track
WHERE deleted_at_ms IS NULL AND play_count > 0
ORDER BY play_count DESC
LIMIT :pageSize;

insert:
INSERT INTO track(
    album_id, artist_id, title, title_sort, duration_ms,
    track_number, disc_number, year, date, genre, composer, bpm,
    codec, bitrate_kbps, sample_rate_hz, bit_depth, channels,
    file_path, file_size_bytes, file_mtime_ms, has_known_mtime,
    replay_gain_track_db, replay_gain_album_db,
    replay_gain_track_peak, replay_gain_album_peak,
    has_embedded_art, art_path,
    source, date_added_ms, date_modified_ms, last_scanned_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

-- Scanner: rewrite all metadata for a file whose mtime changed. Preserves
-- user state (play_count, skip_count, last_played_ms, date_added_ms). Clears
-- deleted_at_ms so reappearing files are reactivated.
updateForRescan:
UPDATE track
SET album_id = ?,
    artist_id = ?,
    title = ?,
    title_sort = ?,
    duration_ms = ?,
    track_number = ?,
    disc_number = ?,
    year = ?,
    date = ?,
    genre = ?,
    composer = ?,
    bpm = ?,
    codec = ?,
    bitrate_kbps = ?,
    sample_rate_hz = ?,
    bit_depth = ?,
    channels = ?,
    file_size_bytes = ?,
    file_mtime_ms = ?,
    has_known_mtime = ?,
    replay_gain_track_db = ?,
    replay_gain_album_db = ?,
    replay_gain_track_peak = ?,
    replay_gain_album_peak = ?,
    has_embedded_art = ?,
    art_path = ?,
    date_modified_ms = :modifiedAtMs,
    last_scanned_ms = :scannedAtMs,
    deleted_at_ms = NULL
WHERE file_path = :filePath;

-- Scanner: minimal touch for an unchanged file (same mtime + size). Only
-- last_scanned_ms gets bumped so the post-scan soft-delete sweep doesn't
-- mark this row as missing.
touchLastScanned:
UPDATE track
SET last_scanned_ms = :scannedAtMs
WHERE file_path = :filePath;

-- Scanner: soft-delete rows that weren't seen during this scan pass. Caller
-- passes the scan-start timestamp; any live row whose last_scanned_ms is
-- older was missing from the filesystem.
softDeleteUnscanned:
UPDATE track
SET deleted_at_ms = :deletedAtMs
WHERE last_scanned_ms < :scanStartedMs
  AND deleted_at_ms IS NULL;

-- Scanner companion to softDeleteUnscanned: returns the count of rows that
-- WOULD be soft-deleted, so the scanner can report tracksSoftDeleted in
-- ScanResult without relying on SqlDriver's affected-row-count exposure.
countUnscanned:
SELECT COUNT(*) FROM track
WHERE last_scanned_ms < :scanStartedMs
  AND deleted_at_ms IS NULL;

-- Scanner FTS5 rebuild: returns all live tracks with the JOIN-resolved
-- display strings for the FTS5 index. COALESCE(_, '') normalizes nullable
-- LEFT JOIN columns to non-null strings (no SQLDelight type-narrowing).
selectAllForFtsRebuild:
SELECT
    track.id              AS track_id,
    track.title           AS title,
    COALESCE(album.name, '')        AS album_name,
    artist.name           AS artist_name,
    COALESCE(album_artist.name, '') AS album_artist_name
FROM track
LEFT JOIN album       ON track.album_id      = album.id
INNER JOIN artist     ON track.artist_id     = artist.id
LEFT JOIN artist AS album_artist ON album.artist_id = album_artist.id
WHERE track.deleted_at_ms IS NULL;

-- Phase 2b-A (A2): Android MediaMetadataRetriever format-fact backfill (F10).
-- Worklist of live rows whose Android format facts haven't been verified yet
-- (metadata_backfilled_at_ms IS NULL). Existing sample_rate_hz / bit_depth /
-- channels are projected so the backfill can carry the NOT-NULL columns
-- through unchanged when MMR can't supply them (MMR exposes bitrate + embedded
-- art reliably, but NOT sample-rate / bit-depth / channel-count — see
-- SafTagReader). No OFFSET: every processed row is stamped, so it leaves the
-- IS NULL worklist immediately and a plain LIMIT loop terminates.
selectTracksNeedingBackfill:
SELECT id, file_path, sample_rate_hz, bit_depth, channels
FROM track
WHERE metadata_backfilled_at_ms IS NULL
  AND deleted_at_ms IS NULL
LIMIT :limit;

-- Count for the backfill worklist — drives the loop-drain assertion + progress.
countTracksNeedingBackfill:
SELECT COUNT(*) FROM track
WHERE metadata_backfilled_at_ms IS NULL
  AND deleted_at_ms IS NULL;

-- Persist MMR-verified format facts + stamp the row out of the worklist.
-- sample_rate_hz / channels are NOT NULL, so the backfill passes through the
-- existing values when MMR doesn't override them (no fabrication).
updateTrackFormatFacts:
UPDATE track
SET sample_rate_hz = :sampleRateHz,
    bit_depth      = :bitDepth,
    channels       = :channels,
    bitrate_kbps   = :bitrateKbps,
    has_embedded_art = :hasEmbeddedArt,
    metadata_backfilled_at_ms = :backfilledAtMs
WHERE id = :id;

-- Stamp a row the backfill couldn't read (file missing / MMR threw / no audio
-- header). Leaves format columns untouched; the stamp alone drains the row
-- from the IS NULL worklist so the loop can't spin on it forever.
markBackfilledNoMetadata:
UPDATE track SET metadata_backfilled_at_ms = :backfilledAtMs WHERE id = :id;

markPlayed:
UPDATE track
SET play_count = play_count + 1,
    last_played_ms = :playedAtMs
WHERE id = ?;

-- Test-only deterministic override. Production code should use markPlayed/
-- markSkipped instead — this exists so TestDb.insertTrack can honor caller-
-- specified play_count + last_played_ms values without an O(playCount) loop
-- and without silently incrementing play_count when the caller passed 0.
setPlayStats:
UPDATE track
SET play_count = :playCount,
    last_played_ms = :lastPlayedMs
WHERE id = :id;

markSkipped:
UPDATE track
SET skip_count = skip_count + 1
WHERE id = ?;

softDelete:
UPDATE track
SET deleted_at_ms = :deletedAtMs
WHERE id = ?;

reactivate:
UPDATE track
SET deleted_at_ms = NULL,
    last_scanned_ms = :scannedAtMs
WHERE id = ?;

-- Phase 2a Track D-A wrap-up: ReplayGain analyzer worklist + persistence.
-- The analyzer runs out-of-band of the main scanner (perf math says ≥17 h
-- for 40k tracks first-pass; a separate trigger from settings UI / background
-- job is the right surface). All queries assume `track.deleted_at_ms IS NULL`
-- — analyzer should not touch soft-deleted rows.

-- Worklist enumeration. Paginated so the runner can yield + report progress.
-- Includes album_id so the runner can group for per-album rollup later.
selectTracksMissingReplayGain:
SELECT id, file_path, codec, sample_rate_hz, bit_depth, channels, album_id
FROM track
WHERE deleted_at_ms IS NULL
  AND replay_gain_track_db IS NULL
ORDER BY id
LIMIT :pageSize OFFSET :pageOffset;

-- Count for the worklist — used for progress reporting in TrackAnalysisRunner.
countTracksMissingReplayGain:
SELECT COUNT(*) FROM track
WHERE deleted_at_ms IS NULL
  AND replay_gain_track_db IS NULL;

-- Per-track persist. `peak` is a linear sample amplitude (RG v2 convention);
-- caller converts from dBTP → linear before invoking.
updateTrackReplayGain:
UPDATE track
SET replay_gain_track_db = :db,
    replay_gain_track_peak = :peak
WHERE id = :id;

-- Distinct album_ids with at least one analyzed track but no album-level
-- aggregate yet. Used at the end of an analyzer pass to drive the rollup.
selectAlbumsForAggregation:
SELECT DISTINCT album_id
FROM track
WHERE album_id IS NOT NULL
  AND deleted_at_ms IS NULL
  AND replay_gain_track_db IS NOT NULL
  AND replay_gain_album_db IS NULL;

-- Per-album rollup input: track-level gains + peaks for one album.
-- The rollup math (energy-weighted mean of LUFS, max of linear peaks)
-- happens in Kotlin in TrackAnalysisRunner.
selectTrackReplayGainForAlbum:
SELECT replay_gain_track_db, replay_gain_track_peak
FROM track
WHERE album_id = :albumId
  AND deleted_at_ms IS NULL
  AND replay_gain_track_db IS NOT NULL;

-- Apply the computed album-level values to all live tracks of the album.
-- `peak` is a linear sample amplitude per RG v2.
updateAlbumReplayGainForAlbum:
UPDATE track
SET replay_gain_album_db = :db,
    replay_gain_album_peak = :peak
WHERE album_id = :albumId
  AND deleted_at_ms IS NULL;
